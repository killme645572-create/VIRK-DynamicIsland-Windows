<UserControl x:Class="Island.TimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="✕" Padding="8,2" Click="Close_Click"/>
            <TextBlock Text="⏱ Таймер" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="TimeText" Grid.Row="1" Text="00:00" FontSize="42" FontWeight="SemiBold"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="2">
            <StackPanel x:Name="SetupRow" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Chip}" Content="1 мин"  Tag="1"  Click="Preset_Click" Margin="3,0"/>
                <Button Style="{StaticResource Chip}" Content="5 мин"  Tag="5"  Click="Preset_Click" Margin="3,0"/>
                <Button Style="{StaticResource Chip}" Content="10 мин" Tag="10" Click="Preset_Click" Margin="3,0"/>
                <Button Style="{StaticResource Chip}" Content="25 мин" Tag="25" Click="Preset_Click" Margin="3,0"/>
                <TextBox x:Name="Input" Width="48" Margin="10,0,0,0" Background="#1FFFFFFF" Foreground="White"
                         CaretBrush="White" BorderThickness="0" Padding="6,5" FontSize="13"
                         VerticalContentAlignment="Center" ToolTip="Свои минуты, Enter — старт"
                         PreviewKeyDown="Input_PreviewKeyDown"/>
                <Button Style="{StaticResource Chip}" Content="▶" Margin="4,0,0,0" Click="Custom_Click"/>
            </StackPanel>

            <StackPanel x:Name="RunRow" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="PauseBtn" Style="{StaticResource Chip}" Content="⏸ Пауза" Click="Pause_Click" Margin="4,0"/>
                <Button Style="{StaticResource Chip}" Content="⏹ Сброс" Click="Stop_Click" Margin="4,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
