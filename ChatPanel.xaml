<UserControl x:Class="Island.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Строка выпадающего списка (провайдер или модель) -->
        <Style x:Key="PickItem" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="✕" Padding="8,2" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ProviderBtn" Style="{StaticResource Chip}" Padding="10,4" FontSize="12"
                        FontWeight="SemiBold" Margin="0,0,6,0" Click="Provider_Click"/>
                <Button x:Name="ModelBtn" Style="{StaticResource Chip}" Padding="10,4" FontSize="12"
                        MaxWidth="270" Click="Model_Click"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Bg}" HorizontalAlignment="{Binding Align}"
                                CornerRadius="14" Padding="10,6" Margin="0,3" MaxWidth="360">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding}" MaxHeight="150" MaxWidth="220" Margin="0,2,6,4"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Text, Mode=OneWay}" Visibility="{Binding TextVis}" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0" Foreground="White"
                                         TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Выпадающий список поверх сообщений -->
        <Border x:Name="PickOverlay" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="10"
                VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="200" MaxWidth="428" MaxHeight="250"
                Background="#F2161616" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PickList"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Приложенные картинки (ещё не отправлены) -->
            <ItemsControl x:Name="AttachList" Grid.Row="0" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="56" Height="56" Margin="0,0,6,0">
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Button Content="✕" Tag="{Binding}" Click="RemoveAttach_Click" Style="{StaticResource Chip}"
                                    Padding="5,0" FontSize="10" Background="#B3000000"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="Input" Grid.Row="1" Background="#1FFFFFFF" Foreground="White" CaretBrush="White"
                     BorderThickness="0" Padding="10,8" FontSize="13" MaxHeight="70"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                     PreviewKeyDown="Input_PreviewKeyDown"/>
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Chip}" Content="📎" Margin="6,0,0,0"
                    ToolTip="Прикрепить картинку (или Ctrl+V)" Click="Attach_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Chip}" Content="➤" Margin="6,0,0,0" Click="Send_Click"/>
        </Grid>
    </Grid>
</UserControl>
